# Start here without credentials. This returns a labelled fixed fixture, not AI.
NEXUS_PROVIDER=demo
# Process-local documents work for a single local/container API, not distributed Lambda.
DOCUMENT_ENABLED=true
# Set provider=bedrock after configuring AWS credentials outside this repo.
AWS_REGION=ap-south-1
# Use a Converse-compatible model ID or inference profile available to your account.
BEDROCK_MODEL_ID=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional locally; required by the cloud template. Enter it in the UI access field.
DEMO_ACCESS_TOKEN=
# Backend-only Tavily key. Enables the Search agent when set.
TAVILY_API_KEY=
# Reserved for later milestones, not consumed yet:
S3_BUCKET=
QDRANT_URL=
QDRANT_API_KEY=
BEDROCK_EMBEDDING_MODEL_ID=
